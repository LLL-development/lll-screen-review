# Configuration for the AI clarification step (Step 5).
#
# Copy this file to .env and fill it in. .env is gitignored and must never be
# committed: it is where a real API key would live.
#
# These are deliberately NOT prefixed with VITE_. Vite injects VITE_ variables
# into the browser bundle, which would hand the key to anyone who opens
# devtools. Without the prefix they stay in the dev server's Node process,
# which is the only place that talks to the model.
#
# Leave CLARIFY_BASE_URL or CLARIFY_MODEL empty and the clarify button hides
# itself; everything else in the tool keeps working.

# Base URL of any OpenAI-compatible chat completions API, without a trailing
# slash. The route calls <CLARIFY_BASE_URL>/chat/completions.
#   Ollama     http://localhost:11434/v1
#   LM Studio  http://localhost:1234/v1
#   OpenAI     https://api.openai.com/v1
CLARIFY_BASE_URL=http://localhost:11434/v1

# Model name as that endpoint spells it.
#   Ollama     llama3.2:3b      (run: ollama pull llama3.2:3b)
#   OpenAI     gpt-4o-mini
CLARIFY_MODEL=llama3.2:3b

# Only needed for hosted endpoints. A model running on this machine has
# nothing to authenticate against, so leave it empty for Ollama or LM Studio.
CLARIFY_API_KEY=
