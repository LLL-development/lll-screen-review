{
  "manifest_version": 3,
  "name": "Screen Review",
  "version": "0.1.0",
  "description": "Click any element on a page and say what's wrong with it.",
  "action": {
    "default_title": "Screen Review: click to switch on"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+R"
      }
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://localhost/*"
  ]
}
